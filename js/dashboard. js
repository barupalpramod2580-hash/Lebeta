import {
  auth,
  db
} from "./firebase.js";

import {
  onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

import {
  collection,
  getDocs,
  query,
  where
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


onAuthStateChanged(
  auth,
  async user => {

    if (!user) {

      location.href =
        "login.html";

      return;

    }


    const q =
      query(
        collection(db, "videos"),
        where(
          "uid",
          "==",
          user.uid
        )
      );


    const snapshot =
      await getDocs(q);


    let views = 0;
    let likes = 0;


    snapshot.forEach(item => {

      const data =
        item.data();

      views +=
        Number(data.views || 0);

      likes +=
        Number(data.likes || 0);

    });


    document.getElementById(
      "videos"
    ).textContent =
      snapshot.size;


    document.getElementById(
      "views"
    ).textContent =
      views;


    document.getElementById(
      "likes"
    ).textContent =
      likes;


    const monetization =
      document.getElementById(
        "monetization"
      );


    document.getElementById(
      "monetize"
    ).onclick = () => {

      /*
       * Demo eligibility.
       * Real monetization will be connected
       * to an actual revenue/payout system later.
       */

      if (
        snapshot.size >= 5 &&
        views >= 1000
      ) {

        monetization.innerHTML =
          "🎉 You are eligible for monetization review.";

      } else {

        monetization.innerHTML =
          "Not eligible yet. Demo requirement: 5 videos + 1,000 total views.";

      }

    };

  }
);
